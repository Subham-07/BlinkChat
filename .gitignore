# ─────────────────────────────────────────────
# BlinkChat — .gitignore
# ─────────────────────────────────────────────

# ── Secrets & environment ──────────────────────
.env
.env.local
.env.*.local
# Allow the example file
!.env.example

# ── Python virtual environments ───────────────
.venv/
venv/
env/
ENV/

# ── Python bytecode & cache ───────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python

# ── Distribution / packaging ──────────────────
dist/
build/
*.egg-info/
*.egg
.eggs/

# ── Test, coverage & linting caches ──────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover

# ── SQLite / database files ───────────────────
*.db
*.sqlite
*.sqlite3

# ── Node / frontend build ─────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
dist/
.next/
.nuxt/
out/

# ── Playwright test artifacts ─────────────────
playwright-report/
test-results/
.playwright/

# ── IDE & editor settings ─────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
*~

# ── OS-generated files ────────────────────────
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
